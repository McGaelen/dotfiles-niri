
// Add lines like this to spawn processes at startup.
// Note that running niri as a session supports xdg-desktop-autostart,
// which may be more convenient to use.
// See the binds section below for more spawn examples.

// To run a shell command (with variables, pipes, etc.), use spawn-sh-at-startup:
spawn-sh-at-startup "gammastep -O 4200"
spawn-sh-at-startup "/usr/lib/policykit-1-pantheon/io.elementary.desktop.agent-polkit" // Polkit
spawn-sh-at-startup "awww-daemon" // Wallpaper daemon
spawn-sh-at-startup "awww img '/usr/share/wallpapers/cachyos-wallpapers/Cachy depths 5K.png'" // Set wallpaper
spawn-sh-at-startup "waybar"
spawn-sh-at-startup "vicinae server"
spawn-sh-at-startup "swaync"
spawn-sh-at-startup "kdeconnect-indicator"
spawn-sh-at-startup "tailscale systray"
